# Cricx X — environment variables (placeholders only, never commit real values)
#
# On Lovable these are filled in automatically by Lovable Cloud — you do not need to set them.
# Browser-safe values (public):
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only values (used by server functions, never sent to the browser):
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Match data comes from SportScore's free public API — no API key is needed.
